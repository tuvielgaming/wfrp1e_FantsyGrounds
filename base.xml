    />


    <!-- WFRP1E graphic resources -->

    <includefile
        source="graphics/graphics_wfrp1e.xml"
    />


    <!-- WFRP1E static/system data -->

    <script
        name="DataCommonWFRP1E"
        file="scripts/data_common_wfrp1e.lua"
    />

    <script
        name="DataLibraryWFRP1E"
        file="scripts/data_library_wfrp1e.lua"
    />

    <script
        name="DataStandardTestsWFRP1E"
        file="scripts/data_standard_tests_wfrp1e.lua"
    />


    <!-- WFRP1E rules managers -->

    <script
        name="ExperienceManagerWFRP1E"
        file="scripts/manager_experience_wfrp1e.lua"
    />

    <script
        name="CharacteristicManagerWFRP1E"
        file="scripts/manager_characteristic_wfrp1e.lua"
    />

    <script
        name="CareerManagerWFRP1E"
        file="scripts/manager_career_wfrp1e.lua"
    />

    <script
        name="CareerDBManagerWFRP1E"
        file="scripts/manager_career_db_wfrp1e.lua"

    />

    <script
        name="CharacterSkillManagerWFRP1E"
        file="scripts/manager_character_skill_wfrp1e.lua"
    />


    <!-- WFRP1E initialization -->

    <script
        name="WFRP1E"
        file="scripts/manager_wfrp1e.lua"
    />


    <!-- WFRP1E campaign records -->

    <includefile
        source="campaign/record_char_main_wfrp1e.xml"
    />

    <includefile
        source="campaign/record_char_career_skills_wfrp1e.xml"
    />

    <includefile
        source="campaign/record_career_wfrp1e.xml"

<?xml version="1.0" encoding="iso-8859-1"?>

<root version="4.8" release="1">

    <description>
        <text>Warhammer Fantasy Roleplay 1st Edition</text>
        <author>WFRP1E Ruleset Project</author>
    </description>


    <!-- CoreRPG inheritance -->

    <importruleset source="CoreRPG" />


    <!-- WFRP1E string resources -->

    <includefile

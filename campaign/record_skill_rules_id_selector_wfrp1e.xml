<?xml version="1.0" encoding="iso-8859-1"?>

<root>

    <!--
        #10O transient Skill Rules ID selector

        The selector and all choice rows are intentionally unbound. The source
        Skill record remains the only persistence owner of `rulesId`.

        IMPORTANT:
        Use windowlist.createWindow(nil) with the statically declared child
        class. Do not use the rejected #10L createWindowWithClass path.
    -->

    <windowclass name="wfrp1e_skill_rules_id_selector">

        <frame>utilitybox</frame>

        <placement>
            <size>
                <width>680</width>
                <height>560</height>
            </size>
        </placement>

        <sizelimits>
            <minimum>
                <width>680</width>
                <height>560</height>
            </minimum>
            <maximum>
                <width>680</width>
                <height>560</height>
            </maximum>
        </sizelimits>

        <script
            file="campaign/scripts/skill_rules_id_selector_wfrp1e.lua"
        />

        <sheetdata>

            <label name="title">
                <bounds>24,20,-24,22</bounds>
                <color>#FFFFFF</color>
                <static textres="wfrp1e_skill_rules_id_select" />
            </label>

            <label name="hint">
                <bounds>24,48,-24,34</bounds>
                <color>#FFFFFF</color>
                <static textres="wfrp1e_skill_rules_id_select_hint" />
            </label>

            <windowlist name="choices">
                <bounds>24,90,-24,-24</bounds>
                <class>wfrp1e_skill_rules_id_choice</class>

                <script>
                    function selectRulesId(sRulesId)
                        window.applyRulesId(sRulesId)
                    end
                </script>
            </windowlist>

        </sheetdata>

    </windowclass>


    <windowclass name="wfrp1e_skill_rules_id_choice">

        <sizelimits>
            <minimum>
                <height>28</height>
            </minimum>
        </sizelimits>

        <script>
            local sChoiceRulesId = ""

            function setChoice(sRulesId, sDisplay)
                sChoiceRulesId = tostring(sRulesId or "")

                choice.setText(
                    tostring(sDisplay or ""),
                    tostring(sDisplay or ""),
                    tostring(sDisplay or "")
                )
            end

            function handleChoice()
                if windowlist
                    and windowlist.selectRulesId
                then
                    windowlist.selectRulesId(
                        sChoiceRulesId
                    )
                end
            end
        </script>

        <sheetdata>

            <buttoncontrol name="choice">
                <bounds>0,0,-1,26</bounds>
                <font>sheettext</font>
                <color>#FFFFFF</color>

                <script>
                    function onButtonPress()
                        window.handleChoice()
                    end
                </script>
            </buttoncontrol>

        </sheetdata>

    </windowclass>

</root>

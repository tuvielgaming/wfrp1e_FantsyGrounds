<?xml version="1.0" encoding="iso-8859-1"?>

<root>

    <!--
        Transient Standard Test selector

        This window is intentionally unbound. It contains no persistent data.
        The caller supplies one Character node, one explicitly selected owned
        Skill rulesId, and named Standard Test candidates.

        Locally resolvable tests execute through the already-verified selected
        Skill roll path. #10P adds one explicit context-required route:
        Bribery -> Bribe opens the transient Bribe preview window instead of
        silently omitting Bribe from the selector.
    -->

    <windowclass name="wfrp1e_standard_test_selector">

        <frame>utilitybox</frame>

        <placement>
            <size>
                <width>500</width>
                <height>220</height>
            </size>
        </placement>

        <sizelimits>
            <minimum>
                <width>500</width>
                <height>220</height>
            </minimum>
            <maximum>
                <width>500</width>
                <height>220</height>
            </maximum>
        </sizelimits>

        <script>
            local nodeCharacter = nil
            local sSelectedSkillRulesId = ""
            local aChoiceTestIds = {}

            local function signedModifier(nModifier)
                nModifier = tonumber(nModifier) or 0

                if nModifier >= 0 then
                    return "+" .. tostring(nModifier)
                end

                return tostring(nModifier)
            end

            local function resetChoice(control, nIndex)
                aChoiceTestIds[nIndex] = nil
                control.setValue("")
                control.setVisible(false)
            end

            local function configureChoice(
                control,
                nIndex,
                sTestId,
                sText
            )
                aChoiceTestIds[nIndex] = sTestId
                control.setValue(sText)
                control.setVisible(true)
            end

            local function configureResolvedChoice(
                control,
                nIndex,
                sTestId,
                tTarget
            )
                configureChoice(
                    control,
                    nIndex,
                    sTestId,
                    sTestId
                    .. "  |  "
                    .. tostring(tTarget.target)
                    .. "%  (base "
                    .. tostring(tTarget.baseTarget)
                    .. "% + Skill "
                    .. signedModifier(tTarget.skillModifier)
                    .. "%)"
                )
            end

            function setContext(
                nodeChar,
                sRulesId,
                aCandidateTestIds
            )
                nodeCharacter = nodeChar
                sSelectedSkillRulesId = tostring(sRulesId or "")

                resetChoice(choice1, 1)
                resetChoice(choice2, 2)
                resetChoice(choice3, 3)

                local aControls = {
                    choice1,
                    choice2,
                    choice3
                }

                local nCreated = 0

                for _, sTestId
                    in ipairs(aCandidateTestIds or {})
                do
                    if sTestId == "bribe"
                        and sSelectedSkillRulesId == "bribery"
                        and nCreated &lt; #aControls
                    then
                        nCreated = nCreated + 1

                        configureChoice(
                            aControls[nCreated],
                            nCreated,
                            sTestId,
                            "bribe  |  enter target WP / procedure context (preview only)"
                        )
                    else
                        local tTarget =
                            StandardTestManagerWFRP1E.resolveSelectedSkillTarget(
                                nodeCharacter,
                                sSelectedSkillRulesId,
                                sTestId
                            )

                        if tTarget.valid
                            and nCreated &lt; #aControls
                        then
                            nCreated = nCreated + 1

                            configureResolvedChoice(
                                aControls[nCreated],
                                nCreated,
                                sTestId,
                                tTarget
                            )
                        end
                    end
                end

                return nCreated
            end

            function handleChoice(nIndex)
                local sTestId =
                    aChoiceTestIds[nIndex]

                if not nodeCharacter
                    or not sTestId
                then
                    return
                end

                if sTestId == "bribe"
                    and sSelectedSkillRulesId == "bribery"
                then
                    local wContext =
                        Interface.openWindow(
                            "wfrp1e_bribe_context",
                            ""
                        )

                    if wContext
                        and wContext.setContext
                    then
                        wContext.setContext(
                            nodeCharacter,
                            sSelectedSkillRulesId
                        )

                        close()
                    end

                    return
                end

                local tResult =
                    StandardTestManagerWFRP1E.performSelectedSkillTest(
                        nodeCharacter,
                        sSelectedSkillRulesId,
                        sTestId
                    )

                if tResult
                    and tResult.launched == true
                then
                    close()
                end
            end
        </script>

        <sheetdata>

            <label name="title">
                <bounds>24,22,-64,22</bounds>
                <color>#FFFFFF</color>
                <static text="SELECT STANDARD TEST" />
            </label>

            <buttoncontrol name="close_button">
                <bounds>-54,16,30,28</bounds>
                <font>sheettext</font>
                <color>#FFFFFF</color>
                <text>X</text>

                <hover>
                    <frame name="fieldfocus" offset="3,2,3,2" />
                    <text>X</text>
                </hover>

                <tooltip text="Close" />

                <script>
                    function onButtonPress()
                        window.close()
                    end
                </script>
            </buttoncontrol>

            <label name="hint">
                <bounds>24,48,-24,20</bounds>
                <color>#FFFFFF</color>
                <static text="Choose the named test for this Skill." />
            </label>

            <stringcontrol name="choice1">
                <bounds>24,82,-24,30</bounds>
                <font>sheettext</font>
                <color>#FFFFFF</color>
                <readonly />
                <nodrag />
                <nodragselect />
                <invisible />

                <stateframe>
                    <hover name="fieldfocus" offset="3,2,3,2" />
                    <pressed name="fieldfocus" offset="3,2,3,2" />
                </stateframe>

                <cursor><hover>hand</hover></cursor>

                <script>
                    function onClickDown(button, x, y)
                        if button == 1 then return true end
                        return false
                    end

                    function onClickRelease(button, x, y)
                        if button == 1 then
                            window.handleChoice(1)
                            return true
                        end
                        return false
                    end
                </script>
            </stringcontrol>

            <stringcontrol name="choice2">
                <bounds>24,120,-24,30</bounds>
                <font>sheettext</font>
                <color>#FFFFFF</color>
                <readonly />
                <nodrag />
                <nodragselect />
                <invisible />

                <stateframe>
                    <hover name="fieldfocus" offset="3,2,3,2" />
                    <pressed name="fieldfocus" offset="3,2,3,2" />
                </stateframe>

                <cursor><hover>hand</hover></cursor>

                <script>
                    function onClickDown(button, x, y)
                        if button == 1 then return true end
                        return false
                    end

                    function onClickRelease(button, x, y)
                        if button == 1 then
                            window.handleChoice(2)
                            return true
                        end
                        return false
                    end
                </script>
            </stringcontrol>

            <stringcontrol name="choice3">
                <bounds>24,158,-24,30</bounds>
                <font>sheettext</font>
                <color>#FFFFFF</color>
                <readonly />
                <nodrag />
                <nodragselect />
                <invisible />

                <stateframe>
                    <hover name="fieldfocus" offset="3,2,3,2" />
                    <pressed name="fieldfocus" offset="3,2,3,2" />
                </stateframe>

                <cursor><hover>hand</hover></cursor>

                <script>
                    function onClickDown(button, x, y)
                        if button == 1 then return true end
                        return false
                    end

                    function onClickRelease(button, x, y)
                        if button == 1 then
                            window.handleChoice(3)
                            return true
                        end
                        return false
                    end
                </script>
            </stringcontrol>

        </sheetdata>

    </windowclass>

</root>

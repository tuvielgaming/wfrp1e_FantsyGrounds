<?xml version="1.0" encoding="iso-8859-1"?>

<root>

    <!--
        #10S transient Hide context preview
        #10U input-style radio choice presentation

        No persistent data. No roll.
        The GM supplies target Initiative; for a group, use the highest
        Initiative in that group.

        One explicitly selected owned Skill contributes its audited Hide effect.
        Concealment requires an explicit movement-state choice. Another owned
        Hide-related Skill is never stacked automatically.
    -->

    <windowclass name="wfrp1e_hide_context">

        <frame>utilitybox</frame>

        <placement>
            <size>
                <width>700</width>
                <height>450</height>
            </size>
        </placement>

        <sizelimits>
            <minimum>
                <width>700</width>
                <height>450</height>
            </minimum>
            <maximum>
                <width>700</width>
                <height>450</height>
            </maximum>
        </sizelimits>

        <script file="campaign/scripts/hide_context_wfrp1e.lua" />

        <sheetdata>

            <label name="title">
                <bounds>24,20,-64,22</bounds>
                <color>#FFFFFF</color>
                <static text="HIDE CONTEXT" />
            </label>

            <buttoncontrol name="close_button">
                <bounds>-54,16,30,28</bounds>
                <font>sheettext</font>
                <color>#FFFFFF</color>
                <text>X</text>

                <hover>
                    <frame name="fieldfocus" offset="3,2,3,2" />
                    <text>X</text>
                </hover>

                <tooltip text="Close" />

                <script>
                    function onButtonPress()
                        window.close()
                    end
                </script>
            </buttoncontrol>

            <label name="hint1">
                <bounds>24,50,-24,20</bounds>
                <color>#FFFFFF</color>
                <static text="Enter the Initiative of the creature being avoided; for a group use the highest Initiative." />
            </label>

            <label name="hint2">
                <bounds>24,74,-24,38</bounds>
                <color>#FFFFFF</color>
                <static text="Only the Skill row you explicitly used contributes here. Rural/Urban applicability remains a GM decision; other owned Skills are not auto-stacked." />
            </label>

            <label name="target_initiative_label">
                <bounds>24,122,250,20</bounds>
                <color>#FFFFFF</color>
                <static text="TARGET INITIATIVE %" />
            </label>

            <basicnumberc name="target_initiative">
                <bounds>290,118,100,28</bounds>
            </basicnumberc>

            <label name="selected_skill_label">
                <bounds>24,158,250,20</bounds>
                <color>#FFFFFF</color>
                <static text="SELECTED SKILL" />
            </label>

            <stringcontrol name="selected_skill_value">
                <bounds>290,154,-24,28</bounds>
                <font>sheettext</font>
                <color>#FFFFFF</color>
                <readonly />
                <nodrag />
                <nodragselect />
            </stringcontrol>

            <label name="concealment_mode_label">
                <bounds>24,194,250,20</bounds>
                <color>#FFFFFF</color>
                <static text="CONCEALMENT STATE" />
                <invisible />
            </label>

            <stringcontrol name="stationary_choice">
                <bounds>290,190,180,28</bounds>
                <font>sheettext</font>
                <color>#000000</color>
                <frame name="fieldlight" />
                <readonly />
                <nodrag />
                <nodragselect />
                <invisible />

                <stateframe>
                    <hover name="fieldfocus" offset="3,2,3,2" />
                    <pressed name="fieldfocus" offset="3,2,3,2" />
                </stateframe>

                <cursor><hover>hand</hover></cursor>

                <script>
                    function onClickDown(button, x, y)
                        if button == 1 then return true end
                        return false
                    end

                    function onClickRelease(button, x, y)
                        if button == 1 then
                            window.setSkillMode("stationary")
                            return true
                        end
                        return false
                    end
                </script>
            </stringcontrol>

            <stringcontrol name="cautious_choice">
                <bounds>480,190,-24,28</bounds>
                <font>sheettext</font>
                <color>#000000</color>
                <frame name="fieldlight" />
                <readonly />
                <nodrag />
                <nodragselect />
                <invisible />

                <stateframe>
                    <hover name="fieldfocus" offset="3,2,3,2" />
                    <pressed name="fieldfocus" offset="3,2,3,2" />
                </stateframe>

                <cursor><hover>hand</hover></cursor>

                <script>
                    function onClickDown(button, x, y)
                        if button == 1 then return true end
                        return false
                    end

                    function onClickRelease(button, x, y)
                        if button == 1 then
                            window.setSkillMode("cautiousMovement")
                            return true
                        end
                        return false
                    end
                </script>
            </stringcontrol>

            <label name="other_modifier_label">
                <bounds>24,230,250,20</bounds>
                <color>#FFFFFF</color>
                <static text="OTHER GM MODIFIER %" />
            </label>

            <basicnumberc name="other_modifier">
                <bounds>290,226,100,28</bounds>
            </basicnumberc>

            <label name="formula_hint">
                <bounds>24,270,-24,20</bounds>
                <color>#FFFFFF</color>
                <static text="Target = (Current Initiative + Current Cool - target Initiative) + selected Skill effect + Other." />
            </label>

            <label name="procedure_hint">
                <bounds>24,294,-24,20</bounds>
                <color>#FFFFFF</color>
                <static text="Shadowing = +10%. Concealment = +20% stationary or +5% cautious movement. Silent Move is not a Hide modifier." />
            </label>

            <stringcontrol name="result_line_1">
                <bounds>24,326,-24,22</bounds>
                <font>sheettext</font>
                <color>#FFFFFF</color>
                <readonly />
                <nodrag />
                <nodragselect />
            </stringcontrol>

            <stringcontrol name="result_line_2">
                <bounds>24,352,-24,22</bounds>
                <font>sheettext</font>
                <color>#FFFFFF</color>
                <readonly />
                <nodrag />
                <nodragselect />
            </stringcontrol>

            <stringcontrol name="result_line_3">
                <bounds>24,378,-180,26</bounds>
                <font>sheetlabel</font>
                <color>#FFFFFF</color>
                <readonly />
                <nodrag />
                <nodragselect />
            </stringcontrol>

            <buttoncontrol name="calculate_button">
                <bounds>-154,400,130,30</bounds>
                <font>sheettext</font>
                <color>#FFFFFF</color>

                <hover>
                    <frame name="fieldfocus" offset="3,2,3,2" />
                </hover>

                <script>
                    function onButtonPress()
                        window.handleCalculate()
                    end
                </script>
            </buttoncontrol>

        </sheetdata>

    </windowclass>

</root>
